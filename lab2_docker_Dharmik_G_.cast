[631.286011, "o", "git clone --sing"]
[631.28705, "o", "le-branch --branch dist-amd64"]
[631.287354, "o", "\r\n"]
[631.288369, "o", "git"]
[631.3063, "o", "fatal: You must specify a repository to clone."]
[631.307073, "o", "\r\n"]
[631.307518, "o", "\r\n"]
[631.307947, "o", "usage: git clone [<options>] [--] <repo> [<dir>]"]
[631.308417, "o", "\r\n"]
[631.308908, "o", "\r\n"]
[631.309374, "o", "    "]
[631.309793, "o", "-v"]
[631.31023, "o", ", "]
[631.310692, "o", "--verbose"]
[631.311162, "o", "         be more verbose"]
[631.311567, "o", "\r\n"]
[631.311975, "o", "    "]
[631.312385, "o", "-q"]
[631.312826, "o", ", "]
[631.31321, "o", "--quiet"]
[631.313652, "o", "           be more quiet"]
[631.314067, "o", "\r\n"]
[631.314442, "o", "    "]
[631.314878, "o", "--progress"]
[631.315278, "o", "            force progress reporting"]
[631.315711, "o", "\r\n"]
[631.316162, "o", "    "]
[631.316592, "o", "-n"]
[631.316989, "o", ", "]
[631.317389, "o", "--no-checkout"]
[631.317837, "o", "     don't create a checkout"]
[631.318089, "o", "\r\n"]
[631.31882, "o", "    "]
[631.319621, "o", "--bare"]
[631.319979, "o", "                create a bare repository"]
[631.320252, "o", "\r\n"]
[631.320521, "o", "    "]
[631.320822, "o", "--mirror"]
[631.321121, "o", "              create a mirror repository (implies bare)"]
[631.321406, "o", "\r\n"]
[631.321664, "o", "    "]
[631.321956, "o", "-l"]
[631.322222, "o", ", "]
[631.322487, "o", "--local"]
[631.322749, "o", "           to clone from a local repository"]
[631.323027, "o", "\r\n"]
[631.323489, "o", "    --no-hardlinks        don't use local hardlinks, always copy\r\n    -s, --shared          setup as shared repository\r\n    --recursive ..."]
[631.323794, "o", "       "]
[631.325579, "o", "alias of --recurse-submodules\r\n    --recurse-submodules"]
[631.325898, "o", "[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    -j, --jobs <n>"]
[631.326239, "o", "        number of submodules cloned in parallel\r\n    --template <template-directory>\r\n                          directory from which templates will be used\r\n    "]
[631.326586, "o", "--reference <repo>    reference repository\r\n    --reference-if-able <repo>\r\n                          reference repository\r\n    "]
[631.326926, "o", "--dissociate          use --reference only while cloning\r\n    -o, --origin <name>   use <name> instead of 'origin' to track upstream"]
[631.32732, "o", "\r\n    -b, --branch <branch>\r\n                          checkout <branch> instead of the remote's HEAD\r\n    "]
[631.327712, "o", "-u, --upload-pack <path>\r\n                          path to git-upload-pack on the remote\r\n    --depth <depth>       create a shallow clone of that depth\r\n    "]
[631.328021, "o", "--shallow-since <time>\r\n                          create a shallow clone since a specific time\r\n"]
[631.328369, "o", "    --shallow-exclude <revision>\r\n                          deepen history of shallow clone, excluding rev\r\n    --single-branch"]
[631.328711, "o", "       clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --shallow-submodules  any cloned submodules will be shallow"]
[631.329078, "o", "\r\n    --separate-git-dir <gitdir>\r\n                          separate git dir from working tree\r\n    "]
[631.329447, "o", "-c, --config <key=value>\r\n                          set config inside the new repository\r\n    "]
[631.32969, "o", "--server-option <server-specific>\r\n                          option to transmit\r\n    -4, --ipv4            use IPv4 addresses only"]
[631.330023, "o", "\r\n    -6, --ipv6            use IPv6 addresses only\r\n    --filter"]
[631.330408, "o", " <args>       object filtering\r\n    --remote-submodules   any cloned submodules will use their remote-tracking branch\r\n"]
[631.331661, "o", "    --sparse              initialize sparse-checkout file to include only files at root\r\n\r\n\u001b]0;student@6312vm-csr51: ~/Desktop\u0007\u001b[01;32mstudent@6312vm-csr51\u001b[00m:\u001b[01;34m~/Desktop\u001b[00m$ https://github.com/tianon/docker-brew-ubuntu-core.git"]
