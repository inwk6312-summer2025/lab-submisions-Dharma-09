[83.310078, "o", " ..."]
[83.310258, "o", "       "]
[83.310409, "o", "alias of --recurse-submodules"]
[83.310629, "o", "\r\n    --recurse-submodules"]
[83.310914, "o", "[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    "]
[83.311198, "o", "-j, --jobs <n>        number of submodules cloned in parallel\r\n"]
[83.311405, "o", "    --template <template-directory>"]
[83.31173, "o", "\r\n                          directory from which templates will be used\r\n    --reference <repo>"]
[83.312104, "o", "    reference repository\r\n    --reference-if-able <repo>\r\n                          reference repository\r\n    --dissociate          use --reference only while cloning"]
[83.314989, "o", "\r\n    -o, --origin <name>   use <name> instead of 'origin' to track upstream\r\n    -b, --branch <branch>"]
[83.315664, "o", "\r\n                          checkout <branch> instead of the remote's HEAD\r\n    -u, --upload-pack <path>\r\n                          path to git-upload-pack on the remote\r\n    --depth <depth>       create a shallow clone of that depth"]
[83.316026, "o", "\r\n    --shallow-since <time>\r\n                          create a shallow clone since a specific time\r\n    --shallow-exclude"]
[83.316466, "o", " <revision>\r\n                          deepen history of shallow clone, excluding rev\r\n    --single-branch       clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --shallow-submodules  any cloned submodules will be shallow\r\n    --separate-git-dir"]
[83.316911, "o", " <gitdir>\r\n                          separate git dir from working tree\r\n    -c, --config <key=value>\r\n"]
[83.317471, "o", "                          set config inside the new repository\r\n    --server-option <server-specific>\r\n                          option to transmit\r\n    -4, --ipv4            use IPv4 addresses only\r\n    -6, --ipv6            use IPv6 addresses only\r\n    --filter <args>       object filtering\r\n    --remote-submodules"]
[83.318914, "o", "   any cloned submodules will use their remote-tracking branch\r\n    --sparse              initialize sparse-checkout file to include only files at root\r\n\r\n\u001b]0;student@6312vm-csr51: ~/Desktop\u0007\u001b[01;32mstudent@6312vm-csr51\u001b[00m:\u001b[01;34m~/Desktop\u001b[00m$ https://github.com/tianon/docker-brew-ubuntu-core.git"]
