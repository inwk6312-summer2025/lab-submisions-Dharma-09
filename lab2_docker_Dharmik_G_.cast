[1232.015446, "o", "\r\n"]
[1232.016124, "o", "Geographic area: "]
[1239.612125, "o", "6"]
[1239.951872, "o", "\r\n\r\nPlease select the city or region corresponding to your time zone.\r\n\r\n  1. Azores   3. Canary      5. Faroe      7. Madeira    9. South_Georgia  11. Stanley\r\n  2. Bermuda  4. Cape_Verde  6. Jan_Mayen  8. Reykjavik  10. St_Helena\r\n"]
