[518.467265, "o", "\r\n"]
[518.467742, "o", "  |     |  +--ro interface*   if:interface-state-ref"]
[518.468103, "o", "\r\n"]
[518.468501, "o", "  |     +--ro routing-protocols"]
[518.468926, "o", "\r\n"]
[518.469352, "o", "  |     |  +--ro routing-protocol* [type name]"]
[518.469747, "o", "\r\n"]
[518.470165, "o", "  |     |     +--ro type    identityref"]
[518.470535, "o", "\r\n"]
[518.470938, "o", "  |     |     +--ro name    string"]
[518.471306, "o", "\r\n"]
[518.471745, "o", "  |     +--ro ribs"]
[518.472134, "o", "\r\n"]
[518.472553, "o", "  |        +--ro rib* [name]"]
[518.472965, "o", "\r\n"]
[518.473401, "o", "  |           +--ro name              string"]
[518.47378, "o", "\r\n"]
[518.474221, "o", "  |           +--ro address-family    identityref"]
[518.47468, "o", "\r\n"]
[518.47513, "o", "  |           +--ro default-rib?      boolean {multiple-ribs}?"]
[518.475512, "o", "\r\n"]
[518.475857, "o", "  |           +--ro routes"]
[518.476073, "o", "\r\n"]
[518.476401, "o", "  |              +--ro route* [destination-prefix]"]
[518.47713, "o", "\r\n"]
[518.4775, "o", "  |                 +--ro route-preference?     route-preference"]
[518.477768, "o", "\r\n"]
[518.478086, "o", "  |                 +--ro destination-prefix    string"]
[518.478379, "o", "\r\n"]
[518.478689, "o", "  |                 +--ro metric?               uint32"]
[518.478943, "o", "\r\n"]
[518.479284, "o", "  |                 +--ro next-hop"]
[518.479531, "o", "\r\n"]
[518.479904, "o", "  |                 |  +--ro (next-hop-options)"]
[518.481053, "o", "\r\n"]
[518.481381, "o", "  |                 |     +--:(simple-next-hop)"]
[518.48164, "o", "\r\n"]
[518.481957, "o", "  |                 |     |  +--ro outgoing-interface?   string"]
[518.482246, "o", "\r\n"]
[518.482574, "o", "  |                 |     |  +--ro next-hop-address?     string"]
[518.482832, "o", "\r\n"]
[518.483153, "o", "  |                 |     +--:(special-next-hop)\r\n"]
[518.483528, "o", "  |                 |        +--ro special-next-hop?     enumeration\r\n  |                 +--ro source-protocol       identityref\r\n"]
[518.483933, "o", "  |                 +--ro active?               empty\r\n  |                 +--ro last-updated?         yang:date-and-time\r\n"]
[518.48439, "o", "  |                 +--ro update-source?        string\r\n  +--rw routing"]
[518.484823, "o", "\r\n     +--rw routing-instance* [name]\r\n        +--rw name                 string"]
[518.485163, "o", "\r\n        +--rw type?                identityref"]
[518.486678, "o", "\r\n        +--rw enabled?             boolean\r\n        +--rw router-id?           yang:dotted-quad {router-id}?"]
[518.487021, "o", "\r\n        +--rw description?         string"]
[518.487412, "o", "\r\n        +--rw interfaces\r\n        |  +--rw interface*   if:interface-ref"]
[518.487847, "o", "\r\n        +--rw routing-protocols\r\n        |  +--rw routing-protocol* [type name]"]
[518.488152, "o", "\r\n        |     +--rw type             identityref"]
[518.48852, "o", "\r\n        |     +--rw name             string\r\n        |     +--rw description?     string"]
[518.488896, "o", "\r\n        |     +--rw static-routes\r\n        +--rw ribs"]
[518.48918, "o", "\r\n           +--rw rib* [name]"]
[518.489686, "o", "\r\n              +--rw name              string"]
[518.489927, "o", "\r\n"]
[518.490245, "o", "              +--rw address-family?   identityref"]
[518.490596, "o", "\r\n              +--rw description?      string"]
[518.492035, "o", "\r\n\r\n"]
[518.492426, "o", "  augment /if:interfaces-state/if:interface:\r\n    +--ro routing-instance?   string"]
[518.492841, "o", "\r\n\r\n  rpcs:\r\n    +---x fib-route"]
[518.493238, "o", "\r\n       +---w input\r\n       |  +---w routing-instance-name    string"]
[518.493473, "o", "\r\n"]
[518.493842, "o", "       |  +---w destination-address\r\n       |     +---w address-family    identityref"]
[518.494275, "o", "\r\n       +--ro output\r\n          +--ro route"]
[518.494666, "o", "\r\n             +--ro address-family     identityref\r\n             +--ro next-hop"]
[518.495066, "o", "\r\n             |  +--ro (next-hop-options)\r\n             |     +--:(simple-next-hop)"]
[518.495454, "o", "\r\n             |     |  +--ro outgoing-interface?   string"]
[518.495861, "o", "\r\n             |     |  +--ro next-hop-address?     string"]
[518.497296, "o", "\r\n             |     +--:(special-next-hop)\r\n             |        +--ro special-next-hop?     enumeration"]
[518.497635, "o", "\r\n             +--ro source-protocol    identityref"]
[518.497965, "o", "\r\n             +--ro active?            empty\r\n             +--ro last-updated?      yang:date-and-time"]
[518.503392, "o", "\r\n"]
