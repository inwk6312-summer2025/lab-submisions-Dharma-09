[934.851942, "o", "\u001b(B\u001b[m"]
[934.854376, "o", "\r\u001b[4d"]
[934.854799, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[6d"]
[934.855208, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[7d"]
[934.855631, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[8d"]
[934.856055, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[9d"]
[934.856452, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[11d"]
[934.856878, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url):\u001b[12;4H"]
[934.857288, "o", "url = BASE_URL + append_url\u001b[13;4H"]
[934.857681, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[14;4H"]
[934.858092, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[16;4H"]
[934.858492, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[17;4H"]
[934.858913, "o", "response = requests.get(url, auth=auth, headers=headers)\u001b[18;4H"]
[934.85931, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[19;8H"]
[934.859753, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[20;8H"]
[934.860197, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4 )\u001b[21;4H"]
[934.860598, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[22d\b"]
[934.861011, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[23;8H"]
[934.861486, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[25d"]
[934.861863, "o", "print(get_interfaces(\u001b(B\u001b[0;1m\u001b[32m'interfaces'\u001b[39m\u001b(B\u001b[m))"]
