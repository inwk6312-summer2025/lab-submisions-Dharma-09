[1387.760783, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[12d"]
[1387.761212, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[14d"]
[1387.76158, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[15;3H"]
[1387.762031, "o", "url = BASE_URL + append_url + interface_name\u001b[16;3H"]
[1387.762428, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[17;3H"]
[1387.762882, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[18;3H"]
[1387.763298, "o", "params = {\u001b(B\u001b[0;1m\u001b[32m'deep'\u001b[39m\u001b(B\u001b[m:\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m}\u001b[20;3H"]
[1387.763797, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;3H"]
[1387.764192, "o", "response = requests.get(url, auth=auth, headers=headers, params=params)\u001b[22;3H"]
[1387.764581, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[23;6H"]
[1387.765047, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[24;6H"]
[1387.765473, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4 )\u001b[25;3H"]
[1387.76593, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[26d\b\b"]
[1387.766284, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[27;6H"]
[1387.766663, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[29d"]
[1387.767046, "o", "\u001b(B\u001b[0;1m\u001b[36mprint \u001b[39m\u001b(B\u001b[m(get_interfaces(\u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet1?verbose\"\u001b[39m\u001b(B\u001b[m)"]
