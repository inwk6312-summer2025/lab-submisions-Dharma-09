[1859.437105, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[3d"]
[1859.437551, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[1859.438065, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[1859.438503, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[6d"]
[1859.438984, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[7d"]
[1859.439433, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[8d"]
[1859.439901, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[9d"]
[1859.440411, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[10d"]
[1859.44085, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[11d"]
[1859.441287, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\r\u001b[12d "]
[1859.441722, "o", "url = BASE_URL + append_url + interface_name\r\u001b[13d "]
[1859.442148, "o", "auth = HTTPBasicAuth(USER, PASS)\r\u001b[14d "]
[1859.442544, "o", "headers = {\r\u001b[15d "]
