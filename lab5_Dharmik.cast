[1859.443428, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[17;2H"]
[1859.443869, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[18d\b"]
[1859.444292, "o", "data = {\r\u001b[19d "]
