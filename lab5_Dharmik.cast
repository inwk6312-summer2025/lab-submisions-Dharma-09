[1766.722879, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                                  New Buffer                                            \u001b[49;1H\u001b(B\u001b[m\u001b[K\u001b[1;101H\u001b[49;27H"]
[1766.723221, "o", "\u001b(B\u001b[0;7m[ Welcome to nano.  For basic help, type Ctrl+G. ]\u001b(B\u001b[m\r\u001b[50d"]
[1766.723836, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[1766.724258, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d\u001b[2d"]
[1766.724833, "o", "\u001b[39;49m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
[1768.349223, "o", "\u001b[?25l"]
[1768.352912, "o", "\u001b[49d"]
[1768.353401, "o", "\u001b[K"]
[1768.371529, "o", "\u001b[1;93H"]
[1768.372248, "o", "\u001b(B\u001b[0;7mModified"]
[1768.372623, "o", "\u001b(B\u001b[m"]
[1768.373364, "o", "\r\u001b[2d"]
[1768.37378, "o", "import logging\r\u001b[3d"]
[1768.374237, "o", "import requests\r\u001b[4d"]
[1768.374665, "o", "from requests.auth import HTTPBasicAuth\r\u001b[5d"]
[1768.375115, "o", "import json\r\u001b[6d"]
[1768.375511, "o", "logging.basicConfig(level=logging.INFO, format='%(name)s - %(levelname)s - %(message)s')\r\u001b[7d"]
[1768.375942, "o", "HOST = '192.168.1.101'\r\u001b[8d"]
[1768.376302, "o", "USER = 'student'\r\u001b[9d"]
[1768.376712, "o", "PASS = 'Meilab123'\r\u001b[10d"]
[1768.377088, "o", "BASE_URL = 'http://{0}/restconf/api/running/'.format(HOST)\r\u001b[11d"]
[1768.377501, "o", "def set_interfaces(append_url, interface_name):\r\u001b[12d"]
[1768.377873, "o", "url = BASE_URL + append_url + interface_name\r\u001b[13d"]
[1768.37828, "o", "auth = HTTPBasicAuth(USER, PASS)\r\u001b[14d"]
[1768.378673, "o", "headers = {\r\u001b[15d"]
[1768.379119, "o", "'Accept': 'application/vnd.yang.data+json',\r\u001b[16d"]
[1768.379537, "o", "'Content-Type': 'application/vnd.yang.data+json'\r\u001b[17d"]
[1768.37999, "o", "}\u001b[18d\b"]
[1768.380398, "o", "data = {\r\u001b[19d"]
[1768.380839, "o", "\"ietf-interfaces:interface\": {\r\u001b[20d"]
[1768.381245, "o", "\"name\": \"GigabitEthernet3\",\r\u001b[21d"]
[1768.381693, "o", "\"description\": \"Changed through Restconf\",\r\u001b[22d"]
[1768.382125, "o", "\"type\": \"iana-if-type:ethernetCsmacd\",\r\u001b[23d"]
[1768.382558, "o", "\"enabled\": 'true',\r\u001b[24d"]
[1768.382945, "o", "\"ietf-ip:ipv4\": {\r\u001b[25d"]
[1768.383349, "o", "\"address\": [\r\u001b[26d"]
[1768.383743, "o", "{\u001b[27d\b"]
[1768.384168, "o", "\"ip\": \"10.0.10.3\",\r\u001b[28d"]
[1768.384568, "o", "\"netmask\": \"255.255.255.0\"\r\u001b[29d"]
[1768.384938, "o", "}\u001b[30d\b"]
[1768.385342, "o", "]\u001b[31d\b"]
[1768.385742, "o", "},\r\u001b[32d"]
[1768.386154, "o", "\"ietf-ip:ipv6\": {}\r\u001b[33d"]
[1768.386522, "o", "}\u001b[34d\b"]
[1768.386784, "o", "}\u001b[35d\b"]
[1768.387064, "o", "response = requests.put(url, auth=auth, headers=headers,\r\u001b[36d"]
[1768.387641, "o", "data=json.dumps(data))\r\u001b[37d"]
[1768.387902, "o", "if response.status_code == 204:\r\u001b[38d"]
[1768.388154, "o", "logging.info(f\"Request was successful on {HOST}, Code: {response.status_code}\")\r\u001b[39d"]
[1768.388419, "o", "return \"success!\"\r\u001b[40d"]
[1768.38868, "o", "else:\r\u001b[41d"]
[1768.388997, "o", "logging.error(f\"Error encountered during request on {HOST}, Code: {response.status_code}\")\r\u001b[42d"]
[1768.389168, "o", "return response.text\r\u001b[43d"]
[1768.389413, "o", "print (set_interfaces(\"interfaces/interface/\", \"GigabitEthernet3\")) "]
[1768.389576, "o", "\u001b[?12l\u001b[?25h"]
[1780.744199, "o", "\u001b[?25l"]
[1780.768558, "o", "\u001b[2;49r\u001b[2;1H"]
[1780.769371, "o", "\u001b[5T\u001b[1;51r\u001b[2;1H"]
[1780.769812, "o", "logging.info(f\"Request was successful on {HOST}, Code: {response.status_code}\")\r\u001b[3d"]
[1780.770275, "o", "return \"success!\"\r\u001b[4d"]
[1780.770735, "o", "else:\r\u001b[5d"]
[1780.771153, "o", "logging.error(f\"Error encountered during request on {HOST}, Code: {response.status_code}\")\r\u001b[6d"]
[1780.771576, "o", "return response.text\r\u001b[7d"]
[1780.772055, "o", "print (set_interfaces(\"interfaces/interface/\", \"GigabitEthernet3\")) import logging\u001b[48;69H"]
