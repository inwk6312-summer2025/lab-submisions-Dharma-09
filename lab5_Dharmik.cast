[1876.81154, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[7d"]
[1876.812073, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[8d"]
