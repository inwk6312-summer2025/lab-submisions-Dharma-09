[1876.812921, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[10d"]
[1876.813361, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[11d"]
[1876.813709, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\r\u001b[12d "]
