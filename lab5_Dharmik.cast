[1140.079162, "o", "\u001b(B\u001b[m"]
[1140.079829, "o", "\r\u001b[50d"]
[1140.080313, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[1140.08077, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[1140.081232, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[1140.082709, "o", "\u001b[2d"]
[1140.083136, "o", "\u001b[39;49m\u001b(B\u001b[mconfigure terminal\r\u001b[3d"]
[1140.08358, "o", "hostname R01\r\u001b[4d"]
[1140.084, "o", "no ip domain lookup\r\u001b[5d"]
[1140.084486, "o", "enable password cisco\r\u001b[6d"]
[1140.085, "o", "ip domain name inwk.local\r\u001b[7d"]
[1140.085441, "o", "username student privilege 15 secret Meilab123\r\u001b[8d"]
[1140.08588, "o", "interface gigabitEthernet 1\r\u001b[9d"]
[1140.086328, "o", "ip address 192.168.1.101 255.255.255.0\r\u001b[10d"]
[1140.086743, "o", "no shutdown\r\u001b[11d"]
[1140.087197, "o", "ip ssh version 2\r\u001b[12d"]
[1140.087633, "o", "line con 0\r\u001b[13d"]
[1140.088071, "o", "logging synchronous\r\u001b[14d"]
[1140.088496, "o", "line vty 0 4\r\u001b[15d"]
[1140.088945, "o", "login local\r\u001b[16d"]
[1140.089349, "o", "transport input ssh\r\u001b[17d"]
