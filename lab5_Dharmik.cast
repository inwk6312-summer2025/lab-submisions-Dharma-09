[1623.752241, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[4d"]
[1623.752655, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[5d"]
[1623.753095, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[6d"]
[1623.753499, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[8d"]
[1623.753934, "o", "logging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[9d"]
[1623.754332, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[10d"]
[1623.754765, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[11d"]
[1623.755159, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[12d"]
[1623.755611, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[14d"]
[1623.756017, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[15;5H"]
[1623.756412, "o", "url = BASE_URL + append_url + interface_name\u001b[16;5H"]
[1623.756836, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[17;5H"]
[1623.757241, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[18;5H"]
[1623.7576, "o", "params = {\u001b(B\u001b[0;1m\u001b[32m'deep'\u001b[39m\u001b(B\u001b[m:\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m}\u001b[19;5H"]
[1623.757991, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\u001b[21;5H"]
[1623.758381, "o", "response = requests.get(url, auth=auth, headers=headers, params=params)\u001b[22;5H"]
[1623.758837, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[23;8H"]
[1623.759241, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[42m \u001b[24;8H"]
[1623.75971, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4 )\u001b[25;5H"]
[1623.760104, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[26d\b\b"]
[1623.760536, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[27;8H"]
[1623.760929, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[28d"]
