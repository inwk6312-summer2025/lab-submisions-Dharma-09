[2049.725135, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[2049.725534, "o", "loopback_config = template.render(data=interfaces)\r\u001b[13d"]
[2049.726002, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[14;3H"]
